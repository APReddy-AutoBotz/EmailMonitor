# Trusted disposable gateway; ephemeral public CA, never database/session secrets.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN python -m pip install --no-cache-dir uv==0.12.23 && uv sync --locked --no-dev
COPY . /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
CMD ["python", "/app/transport_gateway.py"]
