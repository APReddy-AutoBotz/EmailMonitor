# Same immutable browser image and restricted runtime as Dockerfile.operator-ui.
FROM --platform=linux/amd64 mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:96b39581c89131729a7ecb8d532314af54c7f9bcc7a61fe15c7a9e77602acf59
WORKDIR /app
COPY services/backend/pyproject.toml services/backend/uv.lock ./
RUN python -m pip install --no-cache-dir uv==0.12.23 && uv sync --locked
COPY services/backend/src ./src
COPY scripts/isolation/browser_acceptance.py ./browser_acceptance.py
COPY scripts/isolation/operator_ui_protocol.py ./operator_ui_protocol.py
COPY scripts/isolation/operator_ui_acceptance.py ./operator_ui_helpers.py
COPY scripts/isolation/installed_xml_browser.py ./installed_xml_browser.py
COPY scripts/isolation/installed_operator_browser.py ./operator_ui_acceptance.py
COPY scripts/isolation/installed_operator_redirects.py ./installed_operator_redirects.py
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src" PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
