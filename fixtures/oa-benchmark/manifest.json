    {
      "id": "jats-plos-xref",
      "file": "jats-plos-xref.xml",
      "pattern": "PLOS: single corresp note referenced by one author",
      "expected": [
        {
          "address": "r.okafor@immuno.lagos.example",
          "author": "Ngozi Okafor",
          "corresponding": true
        }
      ]
    },
