      "title": "Organization Id",
      "type": "string"
    },
    "contacts": {
      "maximum": 2000,
      "minimum": 0,
      "title": "Contacts",
      "type": "integer"
    },
    "article_outcomes": {
      "maximum": 2000,
      "minimum": 0,
      "title": "Article Outcomes",
      "type": "integer"
    },
    "optional_contact_fields": {
      "items": {
        "enum": [
          "affiliations",
          "article_title"
        ],
        "type": "string"
      },
      "title": "Optional Contact Fields",
      "type": "array"
    },
    "counts_may_change": {
      "const": true,
      "default": true,
