  "title": "ArticleObservation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emailmonitor.example/contracts/article-observation.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1
          },
          "browser_plan": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "requires_browser"
          }
        }
      },
      "then": {
        "properties": {
          "url": {
            "const": "https://synthetic.publisher.example/tooltip.html"
          },
          "route": {
            "const": "html"
          },
          "browser_plan": {
            "const": "synthetic-tooltip-v1"
          }
        },
        "required": [
          "browser_plan"
        ]
      },
      "else": {
        "properties": {
          "browser_plan": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "const": "browser_dom"
          }
        }
      },
      "then": {
        "properties": {
          "url": {
            "const": "https://synthetic.publisher.example/tooltip.html"
          }
        }
      }
    }
  ]
