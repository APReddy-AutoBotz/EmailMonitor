{
  "$defs": {
    "AuthorFact": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "maximum": 100,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "display_name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "affiliations": {
          "items": {
            "maxLength": 1000,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Affiliations",
          "type": "array"
        },
        "orcid": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        },
        "author_kind": {
          "default": "unknown",
          "enum": [
            "person",
            "group",
            "unknown"
          ],
          "title": "Author Kind",
          "type": "string"
        },
        "first": {
          "title": "First",
          "type": "boolean"
        },
        "corresponding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Corresponding"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "position",
        "display_name",
        "affiliations",
        "first",
        "corresponding",
        "evidence"
      ],
      "title": "AuthorFact",
      "type": "object"
    },
    "CandidateFact": {
      "additionalProperties": false,
      "properties": {
        "raw_address": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Raw Address",
          "type": "string"
        },
        "author_positions": {
          "items": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Author Positions",
          "type": "array",
          "uniqueItems": true
        },
        "association_status": {
          "enum": [
            "unmatched",
            "needs_review"
          ],
          "title": "Association Status",
          "type": "string"
        },
        "technical_status": {
          "const": "not_checked",
          "default": "not_checked",
          "title": "Technical Status",
          "type": "string"
        },
        "delivery_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Delivery Status",
          "type": "string"
        },
        "outreach_eligibility": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Outreach Eligibility",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "raw_address",
        "author_positions",
        "association_status",
        "evidence"
      ],
      "title": "CandidateFact",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "association_status": {
                "const": "unmatched"
              }
            }
          },
          "then": {
            "properties": {
              "author_positions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "author_positions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 300,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "enum": [
            "structured_metadata",
            "article_dom",
            "mailto",
            "public_attribute",
            "browser_dom"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "excerpt",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FollowUpFact": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        },
        "depth": {
          "maximum": 2,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "scheduled": {
          "const": false,
          "default": false,
          "title": "Scheduled",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "url",
        "depth",
        "evidence"
      ],
      "title": "FollowUpFact",
      "type": "object"
    },
    "MetadataFact": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "title",
            "journal",
            "publication_date",
            "doi"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "date_type": {
          "default": "unspecified",
          "enum": [
            "published",
            "unspecified"
          ],
          "title": "Date Type",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "field",
        "value",
        "evidence"
      ],
      "title": "MetadataFact",
      "type": "object"
    },
    "MetadataValues": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "journal": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "publication_date": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "doi": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        }
      },
      "title": "MetadataValues",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "title": "Url",
      "type": "string",
      "enum": [
        "https://synthetic.publisher.example/article-a.html",
        "https://synthetic.publisher.example/article-b.html",
        "https://synthetic.publisher.example/tooltip.html",
        "https://synthetic.publisher.example/no-contact.html"
      ]
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "acquisition_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acquisition Digest",
      "type": "string"
    },
    "parser_version": {
      "const": "synthetic-html-v1",
      "default": "synthetic-html-v1",
      "title": "Parser Version",
      "type": "string"
    },
    "route": {
      "enum": [
        "html",
        "browser_dom"
      ],
      "title": "Route",
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "no_contact",
        "requires_browser"
      ],
      "title": "Status",
      "type": "string"
    },
    "metadata": {
      "items": {
        "$ref": "#/$defs/MetadataFact"
      },
      "maxItems": 100,
      "title": "Metadata",
      "type": "array"
    },
    "preferred_metadata": {
      "$ref": "#/$defs/MetadataValues"
    },
