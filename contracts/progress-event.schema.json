{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer",
      "maximum": 9223372036854775807
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "job.queued",
        "job.discovery_progress",
        "job.item_terminal",
        "job.paused",
        "job.cancelled",
        "job.finished",
        "association.reviewed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "aggregate_version": {
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "item_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Item Id"
    },
    "batch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Batch Id"
    },
    "association_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Association Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "job_id",
    "sequence",
    "event_id",
    "event_type",
    "aggregate_version",
    "item_id",
    "batch_id",
    "association_id",
    "occurred_at"
  ],
  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "association.reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "association_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "else": {
        "properties": {
          "batch_id": {
            "type": "null"
          },
          "association_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
