      "default": null,
      "title": "Pages Total"
    },
    "pages_inspected": {
      "maximum": 4,
      "minimum": 0,
      "title": "Pages Inspected",
      "type": "integer"
    },
    "complete_scan": {
      "title": "Complete Scan",
      "type": "boolean"
