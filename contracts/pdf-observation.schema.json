      },
      "maxItems": 20,
      "title": "Metadata",
      "type": "array"
    },
    "preferred_metadata": {
      "$ref": "#/$defs/MetadataValues"
    },
    "identity_association_implemented": {
      "const": false,
      "default": false,
      "title": "Identity Association Implemented",
      "type": "boolean"
    },
    "ocr_implemented": {
      "const": false,
      "default": false,
      "title": "Ocr Implemented",
      "type": "boolean"
    }
  },
  "required": [
    "url",
    "content_digest",
    "status",
    "reason",
    "pages_inspected",
    "complete_scan",
    "preferred_metadata"
  ],
  "title": "PdfObservation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emailmonitor.example/contracts/pdf-observation.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "complete"
          },
          "complete_scan": {
            "const": true
          },
          "authors": {
            "minItems": 1
          },
          "candidates": {
            "minItems": 1
          }
        },
        "required": [
          "authors",
          "candidates"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "no_contact"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "complete"
          },
          "complete_scan": {
            "const": true
          },
          "authors": {
            "minItems": 1
          },
          "candidates": {
            "maxItems": 0
          }
        },
        "required": [
          "authors"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "page_cap"
          },
          "complete_scan": {
            "const": false
          },
          "authors": {
            "minItems": 1
          },
          "pages_inspected": {
            "minimum": 1
          },
          "pages_total": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "authors"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "properties": {
          "complete_scan": {
            "const": false
          },
          "pages_inspected": {
            "const": 0
          },
          "authors": {
            "maxItems": 0
          },
          "candidates": {
            "maxItems": 0
          },
          "metadata": {
            "maxItems": 0
          },
          "reason": {
            "not": {
              "enum": [
                "complete",
                "page_cap"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "enum": [
              "byte_cap",
              "pdf_disabled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
