        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Digest"
    },
    "status": {
      "enum": [
        "observed",
        "no_contact",
        "partial",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "enum": [
        "complete",
        "page_cap",
        "byte_cap",
        "encrypted",
        "corrupt",
        "image_only_or_no_extractable_text",
        "unsupported_geometry",
        "unsupported_font_or_structure",
        "resource_limit",
        "deadline",
        "pdf_disabled"
      ],
      "title": "Reason",
      "type": "string"
    },
    "pages_total": {
      "anyOf": [
        {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
