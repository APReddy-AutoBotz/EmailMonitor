{
  "$defs": {
    "MetadataValues": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "journal": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "publication_date": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "doi": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        }
      },
      "title": "MetadataValues",
      "type": "object"
    },
    "PdfAuthor": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "maximum": 100,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "marker": {
          "maxLength": 2,
          "pattern": "^[1-9][0-9]?$",
          "title": "Marker",
          "type": "string"
        },
        "first": {
          "title": "First",
          "type": "boolean"
        },
        "affiliations": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Affiliations",
          "type": "array"
        },
        "corresponding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corresponding"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PdfEvidence"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "position",
        "display_name",
        "marker",
        "first",
        "evidence"
      ],
      "title": "PdfAuthor",
      "type": "object"
    },
    "PdfCandidate": {
      "additionalProperties": false,
      "properties": {
        "raw_address": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Raw Address",
          "type": "string"
        },
        "author_positions": {
          "items": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Author Positions",
          "type": "array",
          "uniqueItems": true
        },
        "association_status": {
          "enum": [
            "unmatched",
            "needs_review"
          ],
          "title": "Association Status",
          "type": "string"
        },
        "technical_status": {
          "const": "not_checked",
          "default": "not_checked",
          "title": "Technical Status",
          "type": "string"
        },
        "delivery_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Delivery Status",
          "type": "string"
        },
        "outreach_eligibility": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Outreach Eligibility",
          "type": "string"
        },
        "reconstruction": {
          "enum": [
            "literal",
            "adjacent_line_wrap"
          ],
          "title": "Reconstruction",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PdfEvidence"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "raw_address",
        "author_positions",
        "association_status",
        "reconstruction",
        "evidence"
      ],
      "title": "PdfCandidate",
      "type": "object"
    },
    "PdfEvidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "maximum": 4,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "locator": {
          "pattern": "^page:[1-4]:fragment:[0-9]{1,3}$",
          "title": "Locator",
          "type": "string"
        },
        "anchor": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Anchor",
          "type": "array"
        },
        "region": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Region",
          "type": "array"
        },
        "coordinate_units": {
          "const": "pdf_points",
          "default": "pdf_points",
          "title": "Coordinate Units",
          "type": "string"
        },
        "coordinate_origin": {
          "const": "bottom_left",
          "default": "bottom_left",
          "title": "Coordinate Origin",
          "type": "string"
        },
        "region_precision": {
          "const": "full_cropbox_not_glyph_bbox",
          "default": "full_cropbox_not_glyph_bbox",
          "title": "Region Precision",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "page",
        "locator",
        "anchor",
        "region",
        "excerpt"
      ],
      "title": "PdfEvidence",
      "type": "object"
    },
    "PdfMetadata": {
      "additionalProperties": false,
      "properties": {
        "date_type": {
          "const": "unspecified",
          "default": "unspecified",
          "title": "Date Type",
          "type": "string"
        },
        "field": {
          "enum": [
            "title",
            "journal",
            "publication_date",
            "doi"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/PdfEvidence"
        }
      },
      "required": [
        "field",
        "value",
        "evidence"
      ],
      "title": "PdfMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "parser_version": {
      "const": "pypdf-6.20.1-synthetic-v1",
      "default": "pypdf-6.20.1-synthetic-v1",
      "title": "Parser Version",
      "type": "string"
    },
    "route": {
      "const": "pdf",
      "default": "pdf",
      "title": "Route",
      "type": "string"
    },
    "url": {
      "maxLength": 200,
      "title": "Url",
      "type": "string",
      "enum": [
        "https://synthetic.publisher.example/ambiguous.pdf",
        "https://synthetic.publisher.example/article-a.pdf",
        "https://synthetic.publisher.example/article-b.pdf",
        "https://synthetic.publisher.example/corrupt.pdf",
        "https://synthetic.publisher.example/encrypted.pdf",
        "https://synthetic.publisher.example/no-contact.pdf",
        "https://synthetic.publisher.example/page-cap.pdf",
        "https://synthetic.publisher.example/scanned.pdf",
        "https://synthetic.publisher.example/wrapped.pdf"
