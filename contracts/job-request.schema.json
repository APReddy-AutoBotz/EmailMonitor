{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/emailmonitor/schemas/job-request.schema.json",
  "title": "EmailMonitor job creation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input", "purpose", "options"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source_id", "original_query"],
          "properties": {
            "type": {"const": "keyword"},
            "source_id": {"type": "string", "minLength": 1, "maxLength": 100},
            "original_query": {"type": "string", "minLength": 1, "maxLength": 2000},
            "effective_query": {"type": "string", "minLength": 1, "maxLength": 2000},
            "query_change_confirmed": {"type": "boolean", "default": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": {"const": "url"},
            "url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 8192},
            "source_id": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        }
      ]
    },
    "purpose": {"type": "string", "minLength": 1, "maxLength": 200},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication_from": {"type": "string", "format": "date"},
        "publication_to": {"type": "string", "format": "date"},
        "journal": {"type": "string", "maxLength": 300},
        "article_types": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_articles", "max_search_pages", "author_target"],
      "properties": {
        "max_articles": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 500},
        "max_search_pages": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "max_link_depth": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2},
        "author_target": {"enum": ["corresponding", "first", "both", "all"], "default": "both"},
        "allow_pdf": {"type": "boolean", "default": true},
        "allow_browser": {"type": "boolean", "default": true},
        "allow_ocr": {"const": false, "default": false},
        "allow_wider_web": {"const": false, "default": false}
      }
    }
  }
}
