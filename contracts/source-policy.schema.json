{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/emailmonitor/schemas/source-policy.schema.json",
  "title": "EmailMonitor source-policy record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "organization_id", "source_id", "version", "state", "execution_mode", "purpose", "allowed_hosts", "allowed_operations", "permission_reference", "reviewed_by", "approved_at", "valid_until", "limits", "retention", "export_contacts_allowed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "organization_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["pending_review", "approved", "suspended", "expired", "revoked"]},
    "execution_mode": {"enum": ["fixture", "live"]},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 200},
    "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "hostname", "maxLength": 253}},
    "allowed_operations": {"type": "array", "uniqueItems": true, "items": {"enum": ["search", "fetch_html", "browser", "fetch_pdf", "extract_contacts", "retain_excerpt", "export_contacts"]}},
    "permission_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
    "reviewed_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_concurrent_requests", "min_request_interval_seconds", "max_articles_per_job"],
      "properties": {
        "max_concurrent_requests": {"type": "integer", "minimum": 1, "maximum": 20},
        "min_request_interval_seconds": {"type": "number", "minimum": 0.1},
        "max_articles_per_job": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_hours", "excerpt_days", "contact_days"],
      "properties": {
        "raw_hours": {"type": "integer", "minimum": 0, "maximum": 168},
        "excerpt_days": {"type": "integer", "minimum": 0, "maximum": 365},
        "contact_days": {"type": "integer", "minimum": 0, "maximum": 365}
      }
    },
    "export_contacts_allowed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "approved"}}},
      "then": {"properties": {
        "permission_reference": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }}
    },
    {
      "if": {"properties": {"state": {"enum": ["pending_review", "suspended", "expired", "revoked"]}}},
      "then": {"properties": {"export_contacts_allowed": {"const": false}}}
    }
  ]
}
